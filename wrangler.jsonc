{
  "name": "web-chatbot",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Penyimpanan riwayat obrolan. Dibuat otomatis saat deploy.
  // Kalau gagal, buat KV manual di Cloudflare lalu tambahkan "id": "<ID KV>".
  "kv_namespaces": [{ "binding": "CHATS" }]
}
